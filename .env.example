# Copia este archivo como ".env" y llena los valores reales.
# NUNCA subas tu ".env" real a git (ya debería estar en .gitignore).

# ---------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------
# Si este criador comparte proyecto con otros clientes (ver
# sql/multi_tenant_criadores.sql), estas 2 variables son LAS MISMAS
# para todos los criadores que compartan ese proyecto -- lo que
# cambia por cliente es criadorId/criadorSlug en src/site-config.js,
# no estas variables.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# ---------------------------------------------------------------
# Cloudflare R2 (almacenamiento de imágenes)
# ---------------------------------------------------------------
# Igual que las de Supabase arriba: son las mismas para todos los
# criadores que compartan el mismo Worker/bucket. Ver
# worker-upload-imagenes/README.md para configurarlas paso a paso.
VITE_UPLOAD_WORKER_URL=https://criadores-upload-imagenes.tu-subdominio.workers.dev
VITE_R2_PUBLIC_BASE_URL=https://pub-044665661efd4b3a9515c77cf82588ae.r2.dev
